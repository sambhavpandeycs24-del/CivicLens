# Copy to .env before starting Docker Compose
POSTGRES_DB=civiclens
POSTGRES_USER=civiclens_user
POSTGRES_PASSWORD=change_this_local_password
DATABASE_URL=postgresql+psycopg://civiclens_user:change_this_local_password@db:5432/civiclens
JWT_SECRET_KEY=replace_with_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
