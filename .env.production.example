ENVIRONMENT=production
DEBUG=false
POSTGRES_DB=civiclens
POSTGRES_USER=civiclens
POSTGRES_PASSWORD=replace_with_a_unique_database_password
DATABASE_URL=postgresql+psycopg://civiclens:replace_with_a_unique_database_password@db:5432/civiclens
JWT_SECRET_KEY=replace_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=https://reports.example.gov
ALLOWED_HOSTS=reports.example.gov
NEXT_PUBLIC_API_URL=/api/v1
COMPLAINT_UPLOAD_DIR=/app/complaint_uploads
COMPLAINT_UPLOAD_MAX_BYTES=5242880
COMPLAINT_IMAGE_STORAGE=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CATEGORY_MODEL_PATH=/app/data/complaint_category_model.json
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
